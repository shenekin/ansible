[Unit]
Description=etcd distributed key-value store with mutual TLS
Documentation=https://etcd.io/docs/v3.5/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=etcd
Group=etcd
ExecStart={{ etcd_binary_dir | default('/usr/local/bin') }}/etcd \
  --name={{ etcd_name }} \
  --data-dir={{ etcd_data_dir | default('/var/lib/etcd') }} \
  --initial-advertise-peer-urls=https://{{ ansible_host }}:{{ etcd_peer_port }} \
  --listen-peer-urls=https://{{ ansible_host }}:{{ etcd_peer_port }} \
  --advertise-client-urls=https://{{ ansible_host }}:{{ etcd_client_port }} \
  --listen-client-urls=https://{{ ansible_host }}:{{ etcd_client_port }} \
  --initial-cluster={{ etcd_initial_cluster | replace('http://', 'https://') }} \
  --initial-cluster-token={{ etcd_initial_cluster_token }} \
  --initial-cluster-state={{ etcd_initial_cluster_state }} \
  --cert-file=/etc/etcd/pki/server.pem \
  --key-file=/etc/etcd/pki/server-key.pem \
  --trusted-ca-file=/etc/etcd/pki/ca.pem \
  --client-cert-auth=true \
  --peer-cert-file=/etc/etcd/pki/server.pem \
  --peer-key-file=/etc/etcd/pki/server-key.pem \
  --peer-trusted-ca-file=/etc/etcd/pki/ca.pem \
  --peer-client-cert-auth=true
Restart=on-failure
RestartSec=5
LimitNOFILE=40000

[Install]
WantedBy=multi-user.target

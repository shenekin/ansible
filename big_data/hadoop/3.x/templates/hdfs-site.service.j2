<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
{% for name, value in hdfs_site | dictsort %}
  <property>
    <name>{{ name }}</name>
    <value>{{ value | string | lower if value is boolean else value }}</value>
  </property>
{% endfor %}
</configuration>
